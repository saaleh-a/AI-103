# Impeccable's platform binary and bundled data are downloadable build
# artifacts, not source — re-fetch with `npx impeccable install` rather
# than committing ~16-17MB of binary/data into repo history.
.claude/skills/impeccable/scripts/bin/
.claude/skills/impeccable/scripts/data/
.claude/skills/impeccable/scripts/*.js

# Local browser review captures are evidence, not deployed assets.
.impeccable/review/
.impeccable/hook.cache.json

# graphify: machine-specific interpreter/root pointers, transient pipeline sidecars and the
# local extraction cache (its entries embed this machine's absolute paths). The graph,
# report, labels, manifest, cost log and entity-resolution groups are committed.
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_*.json
!graphify-out/.graphify_labels.json
graphify-out/.graphify_*.txt
graphify-out/.needs_update
graphify-out/cache/
graphify-out-wiki/.graphify_analysis.json
__pycache__/
